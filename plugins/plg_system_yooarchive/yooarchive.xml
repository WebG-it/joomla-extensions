<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>plg_system_yooarchive</name>
    <author>Marco Galassi (WebG)</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 Marco Galassi / WebG</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <licence>GNU GPL version 2 or later (GPL-2.0-or-later); see LICENSE.txt</licence>
    <authorEmail>marco.galassi@webg.it</authorEmail>
    <authorUrl>https://www.webg.it</authorUrl>
    <version>2.0.0</version>
    <description>PLG_SYSTEM_YOOARCHIVE_XML_DESCRIPTION</description>
    <namespace path="src">WebG\Plugin\System\Yooarchive</namespace>
    <scriptfile>script.php</scriptfile>
    <changelogurl>https://raw.githubusercontent.com/WebG-it/joomla-extensions/main/changelogs/yooarchive.xml</changelogurl>

    <files>
        <folder plugin="yooarchive">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>bootstrap.php</filename>
        <filename>LICENSE.txt</filename>
    </files>


    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="builder_note"
                    type="note"
                    class="alert alert-info"
                    label="PLG_SYSTEM_YOOARCHIVE_NOTE_BUILDER_LABEL"
                    description="PLG_SYSTEM_YOOARCHIVE_NOTE_BUILDER_DESC"
                />
                <field
                    name="automation_moved_note"
                    type="note"
                    class="alert alert-warning"
                    label="PLG_SYSTEM_YOOARCHIVE_NOTE_AUTOMATION_MOVED_LABEL"
                    description="PLG_SYSTEM_YOOARCHIVE_NOTE_AUTOMATION_MOVED_DESC"
                />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="collection" name="WebG Joomla Extensions">https://raw.githubusercontent.com/WebG-it/joomla-extensions/main/collection.xml</server>
    </updateservers>
</extension>
