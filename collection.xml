<?xml version="1.0" encoding="utf-8"?>
<!--
  WebG Joomla Extensions - catalog / legacy collection update server.
  Each WebG plugin now lives in its own repository and has its own update server (see README.md).
  This collection stays at its old address only so that sites installed before the split find the
  patch release (yooarchive 2.0.1), the new Auto Archive 1.1.0 and Cloudflare Cache Purge 2.1.0: they install them and from then on
  they use the update server of the product repository. Do not add new plugins here.
  PUBLIC repository: never put tokens, passwords or keys in it.
-->
<extensionset name="WebG Joomla Extensions" description="Plugin Joomla sviluppati da WebG">
    <extension
        name="Cloudflare Cache Purge"
        element="cfpurge"
        type="plugin"
        folder="content"
        version="2.1.0"
        detailsurl="https://raw.githubusercontent.com/WebG-it/cloudflare-cache-purge/main/updates/cfpurge.xml" />
    <extension
        name="Archive Layouts for YOOtheme"
        element="yooarchive"
        type="plugin"
        folder="system"
        version="2.0.1"
        detailsurl="https://raw.githubusercontent.com/WebG-it/archive-layouts/main/updates/yooarchive.xml" />
    <extension
        name="Auto Archive"
        element="autoarchive"
        type="plugin"
        folder="system"
        version="1.1.0"
        detailsurl="https://raw.githubusercontent.com/WebG-it/auto-archive/main/updates/autoarchive.xml" />
</extensionset>
