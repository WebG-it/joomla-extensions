{
 "type": "layout",
 "version": "5.0.51",
 "children": [
  {
   "type": "section",
   "props": {
    "style": "default",
    "width": "default"
   },
   "children": [
    {
     "type": "row",
     "props": {},
     "children": [
      {
       "type": "column",
       "props": {
        "width_bp": "m"
       },
       "children": [
        {
         "type": "text",
         "props": {
          "content": "<p class=\"compat-marker\">COMPAT-archive</p>"
         }
        },
        {
         "type": "headline",
         "props": {
          "title_element": "h1",
          "content": "Archivio"
         },
         "source": {
          "query": {
           "name": "yooarchive"
          },
          "props": {
           "content": {
            "name": "categories",
            "filters": {
             "before": "Archivio: "
            }
           }
          }
         }
        },
        {
         "type": "text",
         "props": {
          "content": ""
         },
         "source": {
          "query": {
           "name": "yooarchive"
          },
          "props": {
           "content": {
            "name": "total",
            "filters": {
             "before": "Totale: "
            }
           }
          }
         }
        },
        {
         "type": "html",
         "props": {
          "content": ""
         },
         "source": {
          "query": {
           "name": "yooarchive"
          },
          "props": {
           "content": {
            "name": "filterForm"
           }
          }
         }
        },
        {
         "type": "grid",
         "props": {
          "grid_default": "1",
          "grid_medium": "3",
          "show_title": true,
          "show_content": true,
          "show_meta": true,
          "show_link": true,
          "class": "compat-archive"
         },
         "children": [
          {
           "type": "grid_item",
           "props": {},
           "source": {
            "query": {
             "name": "yooarchiveArticles",
             "arguments": {
              "order": "created",
              "order_direction": "DESC"
             }
            },
            "props": {
             "title": {
              "name": "title"
             },
             "link": {
              "name": "link"
             },
             "meta": {
              "name": "field.comune.name"
             },
             "content": {
              "name": "created",
              "filters": {
               "date": "Y-m-d",
               "datemodify": "+1 year",
               "before": "Data +1 anno: "
              }
             }
            }
           }
          }
         ]
        },
        {
         "type": "yooessentials_markdown",
         "props": {
          "content": "",
          "class": "compat-md"
         },
         "source": {
          "query": {
           "name": "yooarchiveArticle",
           "arguments": {
            "offset": 0
           }
          },
          "props": {
           "content": {
            "name": "title",
            "filters": {
             "before": "## MD: "
            }
           }
          }
         }
        },
        {
         "type": "yooessentials_social_sharing",
         "props": {
          "link_style": "button",
          "class": "compat-share"
         },
         "children": [
          {
           "type": "yooessentials_social_sharing_item",
           "props": {
            "network": "facebook"
           },
           "source": {
            "query": {
             "name": "yooarchiveArticle",
             "arguments": {
              "offset": 0
             }
            },
            "props": {
             "shared_url": {
              "name": "link"
             },
             "shared_text": {
              "name": "title"
             }
            }
           }
          }
         ]
        },
        {
         "type": "grid",
         "props": {
          "grid_default": "1",
          "grid_medium": "3",
          "show_title": true,
          "show_content": true,
          "show_meta": true,
          "show_link": true,
          "class": "compat-csv"
         },
         "children": [
          {
           "type": "grid_item",
           "props": {},
           "source": {
            "query": {
             "name": "csvA1b2c3",
             "field": {
              "name": "records",
              "arguments": {}
             }
            },
            "props": {
             "title": {
              "name": "comune"
             },
             "meta": {
              "name": "provincia"
             },
             "content": {
              "name": "abitanti",
              "filters": {
               "before": "Abitanti: "
              }
             }
            }
           }
          }
         ]
        },
        {
         "type": "pagination",
         "props": {
          "pagination_type": "numeric",
          "text_align": "center"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
