# Copy to .env (never committed) and fill in. Local test environment only.
# Folder that holds YOOtheme Pro: either the official package zip
# (yootheme_j_X.Y.Z.zip from your yootheme.com account) or a copy of the installed
# files of a licensed site (templates/yootheme, plugins/system/yootheme, ...).
YOOTHEME_SRC=../../../yootheme-pro
DEV_PORT=8765
# Choose your own local passwords (admin password: at least 12 characters).
DEV_DB_ROOT_PASSWORD=change-me
DEV_DB_PASSWORD=change-me
DEV_ADMIN_PASSWORD=change-me-12chars
# Optional, compatibility tests only (docker-compose.compat.yml, see DEVELOPING.md):
# JOOMLA_ZIP=./.cache/joomla-5.4.10.zip
# VENDOR_DIR=../../../vendor-licensed
